{
  "name": "@normful/parallel-web-pi-extension",
  "version": "1.1.2",
  "description": "Add Parallel web search, fetch, and research tools to your pi agent",
  "author": "Norman Sue",
  "license": "MIT",
  "type": "module",
  "pi": {
    "image": "https://assets.parallel.ai/white-parallel-avatar-540.png",
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "package.json",
    "README.md"
  ],
  "dependencies": {
    "parallel-web": "1.3.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.83.0",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": ">=0.83.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "typebox": "^1.1.37",
    "typescript": "^5.3.2",
    "vitest": "^5.0.4"
  },
  "scripts": {
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "pi-package",
    "pi.dev",
    "pi agent",
    "extension",
    "parallel",
    "research",
    "web",
    "search",
    "fetch",
    "ai"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/normful/parallel-web-pi-extension-fork.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
